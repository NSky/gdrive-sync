[Unit]
Description=Google Drive FULL bisync (daily resync, includes large files)
After=network-online.target
Conflicts=gdrive-sync.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/gdrive-initial-resync
TimeoutStartSec=1800
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin

[Install]
WantedBy=default.target
