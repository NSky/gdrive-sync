#!/bin/bash
# gdrive-sync - Smart bidirectional sync with Google Drive via rclone bisync
#
# Part of gdrive-sync
# https://github.com/NSky/gdrive-sync
#
# Usage:
#   gdrive-sync            Incremental sync (run by the timer and the watcher)
#   gdrive-sync --resync   Full resync: rebuild the bisync baseline. Run it
#                          after first setup, after changing the filters, or
#                          to recover from a broken state.
#
# Features:
# - Only one sync runs at a time (incremental runs skip, resyncs wait)
# - Auto-resync after consecutive failures
# - JSON status file for monitoring
# - Log rotation (7 days)
# - Conflict resolution: newest wins

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: gdrive-sync [--resync]

Bidirectional sync between a local directory and Google Drive.

  (no option)   Incremental sync. Skips if another sync is running.
  --resync      Full resync to rebuild the sync baseline. Waits for a
                running sync to finish. Use after first setup, after
                changing the filters, or to recover from errors.
  -h, --help    Show this help.

Configuration: ~/.config/gdrive-sync/config.env (or $GDRIVE_CONFIG)
EOF
}

# === Arguments ===
MODE="sync"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --resync) MODE="resync" ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "gdrive-sync: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# === Load Configuration ===
CONFIG_FILE="${GDRIVE_CONFIG:-$HOME/.config/gdrive-sync/config.env}"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

REMOTE="${GDRIVE_REMOTE:-gdrive:}"
LOCAL="${GDRIVE_LOCAL:-$HOME/gdrive}"
STATE_DIR="${GDRIVE_STATE_DIR:-$HOME/.local/state/gdrive-sync}"
LOG_DIR="$STATE_DIR/logs"
STATUS_FILE="$STATE_DIR/status.json"
FAILURE_FILE="$STATE_DIR/consecutive_failures"
FILTERS="${GDRIVE_FILTERS:-$HOME/.config/gdrive-sync/bisync-filters.txt}"
# Fall back to the packaged default filters if the user has no copy
# (<prefix>/share/gdrive-sync next to <prefix>/bin where this script lives)
DEFAULT_FILTERS="$(dirname "$(readlink -f "$0")")/../share/gdrive-sync/bisync-filters.txt"
if [[ ! -f "$FILTERS" && -f "$DEFAULT_FILTERS" ]]; then
    FILTERS="$DEFAULT_FILTERS"
fi
MAX_FAILURES="${GDRIVE_MAX_FAILURES:-6}"
LOCK_TIMEOUT="${GDRIVE_LOCK_TIMEOUT:-10}"

# Only one sync (timer, watcher or manual resync) runs at a time.
# Stale rclone locks left by a killed run expire via --max-lock.
SYNC_LOCK="$STATE_DIR/sync.lock"

# === Functions ===

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

# Read a field from the previous status file, or print the default
previous_status() {
    jq -r --arg d "$2" ".$1 // \$d" "$STATUS_FILE" 2>/dev/null || echo "$2"
}

# update_status <status> <message> <mode>
update_status() {
    local status="$1"
    local message="$2"
    local mode="$3"
    local now failures last_success last_resync
    now=$(date -Iseconds)
    failures=$(get_failures)
    last_success=$(previous_status last_success never)
    last_resync=$(previous_status last_resync never)

    if [[ "$status" == "success" ]]; then
        last_success="$now"
        if [[ "$mode" == "resync" ]]; then
            last_resync="$now"
        fi
    fi

    # jq escapes the values; writing to a temp file and renaming means
    # readers never see a half-written status file
    jq -n \
        --arg status "$status" \
        --arg mode "$mode" \
        --arg message "$message" \
        --argjson failures "$failures" \
        --arg last_success "$last_success" \
        --arg last_resync "$last_resync" \
        --arg updated_at "$now" \
        --arg log_file "$LOG_FILE" \
        '{status: $status, mode: $mode, message: $message,
          consecutive_failures: $failures, last_success: $last_success,
          last_resync: $last_resync, updated_at: $updated_at,
          log_file: $log_file}' \
        > "$STATUS_FILE.tmp" && mv "$STATUS_FILE.tmp" "$STATUS_FILE"
}

cleanup_old_logs() {
    find "$LOG_DIR" -name "*.log" -mtime +7 -delete 2>/dev/null || true
}

get_failures() {
    local n
    n=$(cat "$FAILURE_FILE" 2>/dev/null || true)
    # Treat a missing or corrupt counter as 0
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    echo "$n"
}

increment_failures() {
    local current
    current=$(get_failures)
    echo $((current + 1)) > "$FAILURE_FILE"
}

reset_failures() {
    echo 0 > "$FAILURE_FILE"
}

# Arguments shared by incremental runs and resyncs. Both must use the
# same filters: bisync needs the baseline built by --resync to match.
common_args() {
    COMMON_ARGS=(
        --resilient
        --conflict-resolve newer
        --conflict-suffix "_{datestr}"
        --max-lock "${LOCK_TIMEOUT}m"
        -v
    )
    if [[ -f "$FILTERS" ]]; then
        COMMON_ARGS+=(--filters-file "$FILTERS")
    fi
}

do_resync() {
    log "Executing full RESYNC..."
    log "Filters: $( [[ -f "$FILTERS" ]] && echo "$FILTERS" || echo none )"
    common_args
    # --resync-mode newer keeps the newer copy when a file differs on both
    # sides; the default (path1) would let Drive overwrite newer local edits.
    rclone bisync "$REMOTE" "$LOCAL" --resync --resync-mode newer "${COMMON_ARGS[@]}"
}

do_bisync() {
    local output_file
    output_file=$(mktemp)
    local exit_code=0

    common_args
    rclone bisync "$REMOTE" "$LOCAL" "${COMMON_ARGS[@]}" 2>&1 | tee "$output_file" || exit_code=$?

    # Detect remote changes (coming from Drive)
    detect_remote_changes "$output_file"

    rm -f "$output_file"
    return $exit_code
}

detect_remote_changes() {
    local output_file="$1"
    local remote_changes_file="$STATE_DIR/last_remote_changes.txt"

    local remote_files
    remote_files=$(grep -E "Path1.*queue copy to Path2|Copying.*${REMOTE}" "$output_file" 2>/dev/null | head -20 || true)

    if [[ -n "$remote_files" ]]; then
        local count
        count=$(echo "$remote_files" | wc -l)
        log "Detected $count remote changes from Drive"

        echo "=== $(date -Iseconds) ===" >> "$remote_changes_file"
        echo "$remote_files" >> "$remote_changes_file"
        echo "" >> "$remote_changes_file"

        # Keep file small (last 100 lines)
        if [[ -f "$remote_changes_file" ]]; then
            tail -100 "$remote_changes_file" > "$remote_changes_file.tmp" && mv "$remote_changes_file.tmp" "$remote_changes_file"
        fi
    fi
}

# === Main ===

mkdir -p "$LOG_DIR" "$STATE_DIR"

# Take the sync lock (held on fd 9 until this script and rclone exit).
# An incremental run skips if another sync holds it: the next timer run
# catches up. A requested resync waits for the running sync instead.
exec 9>"$SYNC_LOCK"
if ! flock -n 9; then
    if [[ "$MODE" == "sync" ]]; then
        log "Another sync is in progress. Skipping."
        exit 0
    fi
    log "Another sync is running; waiting up to ${LOCK_TIMEOUT} minutes..."
    if ! flock -w "$((LOCK_TIMEOUT * 60))" 9; then
        log "ERROR: Timed out waiting for the running sync to finish."
        exit 1
    fi
fi

# Too many consecutive failures: recover with a resync, the same as a
# requested one
failures=$(get_failures)
AUTO_RESYNC=0
if [[ "$MODE" == "sync" && $failures -ge $MAX_FAILURES ]]; then
    MODE="resync"
    AUTO_RESYNC=1
fi

LOG_FILE="$LOG_DIR/${MODE}_$(date '+%Y%m%d_%H%M%S').log"

{
    log "Starting gdrive-sync ($MODE)"
    log "Remote: $REMOTE"
    log "Local:  $LOCAL"

    # Clean old logs
    cleanup_old_logs

    if [[ "$MODE" == "resync" ]]; then
        if [[ $AUTO_RESYNC -eq 1 ]]; then
            log "WARNING: $failures consecutive failures. Forcing resync..."
            success_message="Resync completed after $failures failures"
        else
            success_message="Resync completed"
        fi
        update_status "running" "Resync in progress" "$MODE"

        if do_resync; then
            log "Full resync completed successfully!"
            reset_failures
            update_status "success" "$success_message" "$MODE"
        else
            log "ERROR: Resync failed!"
            increment_failures
            update_status "error" "Resync failed" "$MODE"
            exit 1
        fi
    else
        update_status "running" "Sync in progress" "$MODE"

        if do_bisync; then
            log "Sync completed successfully!"
            reset_failures
            update_status "success" "Sync OK" "$MODE"
        else
            exit_code=$?
            increment_failures
            new_failures=$(get_failures)
            log "ERROR: Sync failed (code: $exit_code). Consecutive failures: $new_failures"
            update_status "error" "Failure #$new_failures (code: $exit_code)" "$MODE"
            exit 1
        fi
    fi

    log "gdrive-sync finished"

} 2>&1 | tee "$LOG_FILE"
