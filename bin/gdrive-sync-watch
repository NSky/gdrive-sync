#!/bin/bash
# gdrive-sync-watch - Monitor local changes and trigger immediate sync
#
# Part of gdrive-sync
# https://github.com/NSky/gdrive-sync
#
# Uses inotifywait to detect local file changes and triggers
# gdrive-sync with a configurable debounce delay.

set -euo pipefail

# === Load Configuration ===
CONFIG_FILE="${GDRIVE_CONFIG:-$HOME/.config/gdrive-sync/config.env}"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

WATCH_DIR="${GDRIVE_LOCAL:-$HOME/gdrive}"
SYNC_CMD="${GDRIVE_SYNC_CMD:-$(dirname "$(readlink -f "$0")")/gdrive-sync}"
DEBOUNCE_SEC="${GDRIVE_DEBOUNCE_SEC:-5}"
STATE_DIR="${GDRIVE_STATE_DIR:-$HOME/.local/state/gdrive-sync}"
WATCH_LOG="$STATE_DIR/watch.log"

# How long to wait for events before doing housekeeping (log rotation)
IDLE_SEC=300

# Temporary files that should not trigger a sync
EXCLUDE='(~\$|\.tmp$|\.swp$|\.partial$|\.crdownload$|__pycache__|\.git/)'

# === Functions ===

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WATCH] $*" | tee -a "$WATCH_LOG"
}

rotate_log() {
    if [[ -f "$WATCH_LOG" ]] && [[ $(stat -c%s "$WATCH_LOG" 2>/dev/null || echo 0) -gt 1048576 ]]; then
        mv "$WATCH_LOG" "$WATCH_LOG.old"
        log "Log rotated"
    fi
}

trigger_sync() {
    # gdrive-sync takes the shared sync lock itself and skips if another
    # sync (timer run or a resync) is already in progress.
    log "Triggering sync due to local change..."
    if "$SYNC_CMD"; then
        log "Sync from local change completed!"
    else
        log "Sync returned an error (see gdrive-sync logs)"
    fi
}

cleanup() {
    log "Stopping gdrive-sync-watch..."
    if [[ -n "${INOTIFY_PID:-}" ]]; then
        kill "$INOTIFY_PID" 2>/dev/null || true
    fi
    exit 0
}

# inotifywait exited (watched directory removed, inotify watch limit
# reached, ...). Exit with an error and let systemd restart us after
# RestartSec instead of spinning.
watcher_died() {
    local rc=0
    wait "$INOTIFY_PID" 2>/dev/null || rc=$?
    log "ERROR: inotifywait stopped (exit code $rc). Exiting so systemd can restart the watcher."
    exit 1
}

# inotifywait keeps running with no watches if the watched directory
# itself is removed, so check for it explicitly.
check_watch_dir() {
    if [[ ! -d "$WATCH_DIR" ]]; then
        log "ERROR: Watched directory disappeared: $WATCH_DIR. Exiting so systemd can restart the watcher."
        kill "$INOTIFY_PID" 2>/dev/null || true
        exit 1
    fi
}

# === Main ===

mkdir -p "$STATE_DIR"

trap cleanup SIGTERM SIGINT SIGHUP

log "Starting file watcher on: $WATCH_DIR"
log "Debounce: ${DEBOUNCE_SEC}s"

# Verify directory exists
if [[ ! -d "$WATCH_DIR" ]]; then
    log "ERROR: Directory not found: $WATCH_DIR"
    exit 1
fi

rotate_log

# One long-running inotifywait in monitor mode sets up the recursive
# watches once and streams events on fd 3. Events that happen while a
# sync is running are buffered and picked up afterwards.
exec 3< <(exec inotifywait \
    -m \
    -r \
    -q \
    -e modify,create,delete,moved_to,moved_from \
    --exclude "$EXCLUDE" \
    --format '%w%f %e' \
    "$WATCH_DIR")
INOTIFY_PID=$!

# read -t returns >128 on timeout and 1 on EOF (inotifywait exited)
while true; do
    rc=0
    read -r -t "$IDLE_SEC" -u 3 _event || rc=$?

    if [[ $rc -eq 0 ]]; then
        log "Change detected. Waiting ${DEBOUNCE_SEC}s for debounce..."

        # Debounce: keep waiting while events keep arriving
        while true; do
            rc=0
            read -r -t "$DEBOUNCE_SEC" -u 3 _event || rc=$?
            if [[ $rc -eq 0 ]]; then
                continue
            elif [[ $rc -gt 128 ]]; then
                break
            else
                watcher_died
            fi
        done

        check_watch_dir
        trigger_sync
    elif [[ $rc -gt 128 ]]; then
        # No events for IDLE_SEC: all quiet
        check_watch_dir
        rotate_log
    else
        watcher_died
    fi
done
