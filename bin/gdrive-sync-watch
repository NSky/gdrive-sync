#!/bin/bash
# gdrive-sync-watch - Monitor local changes and trigger immediate sync
#
# Part of linux-gdrive-sync
# https://github.com/namastexlabs/linux-gdrive-sync
#
# Uses inotifywait to detect local file changes and triggers
# gdrive-sync with a configurable debounce delay.

set -euo pipefail

# === Load Configuration ===
CONFIG_FILE="${GDRIVE_CONFIG:-$HOME/.config/gdrive-sync/config.env}"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

WATCH_DIR="${GDRIVE_LOCAL:-$HOME/gdrive}"
SYNC_CMD="${GDRIVE_SYNC_CMD:-$(dirname "$(readlink -f "$0")")/gdrive-sync}"
DEBOUNCE_SEC="${GDRIVE_DEBOUNCE_SEC:-5}"
STATE_DIR="${GDRIVE_STATE_DIR:-$HOME/.local/state/gdrive-sync}"
WATCH_LOG="$STATE_DIR/watch.log"

# Lock to prevent simultaneous syncs
LOCK_FILE="$STATE_DIR/watch-sync.lock"

# === Functions ===

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WATCH] $*" | tee -a "$WATCH_LOG"
}

rotate_log() {
    if [[ -f "$WATCH_LOG" ]] && [[ $(stat -c%s "$WATCH_LOG" 2>/dev/null || echo 0) -gt 1048576 ]]; then
        mv "$WATCH_LOG" "$WATCH_LOG.old"
        log "Log rotated"
    fi
}

trigger_sync() {
    # Skip if sync already running
    if [[ -f "$LOCK_FILE" ]]; then
        local lock_pid
        lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
        if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
            log "Sync already in progress (PID: $lock_pid). Skipping."
            return 0
        else
            log "Orphaned lock found. Removing."
            rm -f "$LOCK_FILE"
        fi
    fi

    # Create lock with our PID
    echo $$ > "$LOCK_FILE"

    log "Triggering sync due to local change..."
    if "$SYNC_CMD"; then
        log "Sync from local change completed!"
    else
        log "Sync returned error (may be normal if another sync was running)"
    fi

    rm -f "$LOCK_FILE"
}

cleanup() {
    log "Stopping gdrive-sync-watch..."
    rm -f "$LOCK_FILE"
    # Kill inotifywait if running
    if [[ -n "${INOTIFY_PID:-}" ]]; then
        kill "$INOTIFY_PID" 2>/dev/null || true
    fi
    exit 0
}

# === Main ===

mkdir -p "$STATE_DIR"

trap cleanup SIGTERM SIGINT SIGHUP

log "Starting file watcher on: $WATCH_DIR"
log "Debounce: ${DEBOUNCE_SEC}s"

# Verify directory exists
if [[ ! -d "$WATCH_DIR" ]]; then
    log "ERROR: Directory not found: $WATCH_DIR"
    exit 1
fi

rotate_log

# Main loop: inotifywait in monitor mode
# Recursively monitor for relevant changes
# Exclude temporary files (Office ~$, .tmp, .swp, .partial)
while true; do
    # inotifywait blocks until an event is detected
    # Timeout for periodicity and resilience
    inotifywait \
        -r \
        -t 300 \
        -e modify,create,delete,moved_to,moved_from \
        --exclude '(~\$|\.tmp$|\.swp$|\.partial$|\.crdownload$|__pycache__|\.git/)' \
        --format '%w%f %e %T' \
        --timefmt '%H:%M:%S' \
        "$WATCH_DIR" 2>/dev/null &
    INOTIFY_PID=$!

    # Wait for inotifywait to finish (event detected or timeout)
    if wait "$INOTIFY_PID" 2>/dev/null; then
        # Event detected! Apply debounce
        log "Change detected. Waiting ${DEBOUNCE_SEC}s for debounce..."

        # Debounce: wait for more events for DEBOUNCE_SEC seconds
        # If more events arrive, the timer resets
        DEBOUNCE_REMAINING=$DEBOUNCE_SEC
        while [[ $DEBOUNCE_REMAINING -gt 0 ]]; do
            if inotifywait \
                -r \
                -t 1 \
                -e modify,create,delete,moved_to,moved_from \
                --exclude '(~\$|\.tmp$|\.swp$|\.partial$|\.crdownload$|__pycache__|\.git/)' \
                "$WATCH_DIR" >/dev/null 2>&1; then
                # More changes! Reset debounce
                DEBOUNCE_REMAINING=$DEBOUNCE_SEC
                log "More changes detected. Resetting debounce..."
            else
                DEBOUNCE_REMAINING=$((DEBOUNCE_REMAINING - 1))
            fi
        done

        # Debounce complete, trigger sync
        trigger_sync
    else
        # Timeout (no events in 5 min) - all quiet
        rotate_log
    fi

    unset INOTIFY_PID
done
