#!/bin/bash
# gdrive-sync-setup - Per-user setup for gdrive-sync
#
# Run once as your own user (not root) after installing the package.
# It will:
# 1. Check for required dependencies (rclone, inotify-tools, jq)
# 2. Prompt for configuration and write ~/.config/gdrive-sync/config.env
# 3. Set up the Google Drive client ID and the rclone remote
# 4. Optionally run the initial resync
# 5. Optionally enable the systemd user services for your account
#
# The package itself never enables or starts any service.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Paths
SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
CONFIG_DIR="$HOME/.config/gdrive-sync"
CONFIG_FILE="$CONFIG_DIR/config.env"
STATE_DIR="$HOME/.local/state/gdrive-sync"

# Default configuration
DEFAULT_LOCAL="$HOME/gdrive"
DEFAULT_REMOTE="gdrive:"

UNITS=(gdrive-sync.timer gdrive-sync-watch.service)

log_info() {
    echo -e "${BLUE}[INFO]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*"
}

check_command() {
    command -v "$1" &>/dev/null
}

# Locate the packaged data dir (<prefix>/share/gdrive-sync), or the
# repository's filters/ dir when running from a source checkout.
find_default_filters() {
    local candidate
    for candidate in \
        "$SELF_DIR/../share/gdrive-sync/bisync-filters.txt" \
        "$SELF_DIR/../filters/bisync-filters.txt"; do
        if [[ -f "$candidate" ]]; then
            readlink -f "$candidate"
            return 0
        fi
    done
    return 1
}

# Expand a leading ~ and turn the path into an absolute one, so the
# config works no matter which directory the services start in.
normalize_path() {
    local path="$1"
    case "$path" in
        "~")   path="$HOME" ;;
        "~/"*) path="$HOME/${path#"~/"}" ;;
    esac
    realpath -m -- "$path"
}

# Name of the rclone remote in "remote:" or "remote:some/folder"
remote_name() {
    echo "${REMOTE_NAME%%:*}"
}

# === Sanity Checks ===

check_not_root() {
    if [[ $EUID -eq 0 ]]; then
        log_error "Run gdrive-sync-setup as your own user, not as root."
        exit 1
    fi
}

check_dependencies() {
    log_info "Checking dependencies..."

    local missing=()

    if ! check_command rclone; then
        missing+=("rclone")
    else
        log_success "rclone found: $(rclone --version | head -1)"
    fi

    if ! check_command inotifywait; then
        missing+=("inotify-tools")
    else
        log_success "inotifywait found"
    fi

    if ! check_command jq; then
        missing+=("jq")
    else
        log_success "jq found"
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing dependencies: ${missing[*]}"
        log_error "Install them with your system package manager."
        exit 1
    fi
}

# === Configuration ===

configure() {
    echo ""
    echo "=========================================="
    echo "  Configure gdrive-sync "
    echo "=========================================="
    echo ""

    # Re-running setup: offer the current values as defaults
    if [[ -f "$CONFIG_FILE" ]]; then
        log_info "Existing configuration found at $CONFIG_FILE"
        # shellcheck source=/dev/null
        DEFAULT_LOCAL="$(source "$CONFIG_FILE" && echo "${GDRIVE_LOCAL:-$DEFAULT_LOCAL}")"
        # shellcheck source=/dev/null
        DEFAULT_REMOTE="$(source "$CONFIG_FILE" && echo "${GDRIVE_REMOTE:-$DEFAULT_REMOTE}")"
    fi

    # Local directory
    read -rp "Local sync directory [$DEFAULT_LOCAL]: " LOCAL_DIR
    LOCAL_DIR="$(normalize_path "${LOCAL_DIR:-$DEFAULT_LOCAL}")"

    # Remote name
    read -rp "rclone remote name [$DEFAULT_REMOTE]: " REMOTE_NAME
    REMOTE_NAME="${REMOTE_NAME:-$DEFAULT_REMOTE}"

    # A bare remote name gets a trailing ':'; "remote:folder" is kept as is
    if [[ "$REMOTE_NAME" != *:* ]]; then
        REMOTE_NAME="${REMOTE_NAME}:"
    fi

    echo ""
    log_info "Configuration:"
    echo "  Local directory: $LOCAL_DIR"
    echo "  Remote name: $REMOTE_NAME"
    echo ""

    read -rp "Is this correct? [Y/n]: " confirm
    if [[ "${confirm,,}" == "n" ]]; then
        configure
        return
    fi

    mkdir -p "$CONFIG_DIR" "$STATE_DIR/logs"

    if [[ -f "$CONFIG_FILE" ]]; then
        cp "$CONFIG_FILE" "$CONFIG_FILE.bak"
        log_info "Previous configuration backed up to $CONFIG_FILE.bak"
    fi

    # printf %q quotes values so spaces, quotes or $ in paths survive
    # being sourced by the sync scripts
    local q_local q_remote q_state q_filters
    q_local=$(printf %q "$LOCAL_DIR")
    q_remote=$(printf %q "$REMOTE_NAME")
    q_state=$(printf %q "$STATE_DIR")
    q_filters=$(printf %q "$CONFIG_DIR/bisync-filters.txt")

    cat > "$CONFIG_FILE" <<EOF
# gdrive-sync configuration
# Generated by gdrive-sync-setup on $(date)

# Local directory to sync with Google Drive
GDRIVE_LOCAL=$q_local

# rclone remote name (as configured in rclone config)
GDRIVE_REMOTE=$q_remote

# State directory for logs, status, and lock tracking
GDRIVE_STATE_DIR=$q_state

# Path to bisync filters file
GDRIVE_FILTERS=$q_filters

# Maximum consecutive failures before forcing a full resync
GDRIVE_MAX_FAILURES=6

# Lock timeout in minutes
GDRIVE_LOCK_TIMEOUT=10

# Debounce delay in seconds for the file watcher
GDRIVE_DEBOUNCE_SEC=5
EOF

    log_success "Configuration saved to $CONFIG_FILE"

    # Give the user an editable copy of the default filters
    if [[ ! -f "$CONFIG_DIR/bisync-filters.txt" ]]; then
        local default_filters
        if default_filters="$(find_default_filters)"; then
            cp "$default_filters" "$CONFIG_DIR/bisync-filters.txt"
            log_success "Filter file copied to $CONFIG_DIR/bisync-filters.txt"
        else
            log_warn "Default filter file not found; syncing without filters"
        fi
    else
        log_info "Filter file already exists, keeping existing"
    fi

    mkdir -p "$LOCAL_DIR"
    log_success "Local directory ready: $LOCAL_DIR"
}

# === Google Drive Client ID ===

setup_client_id() {
    # TODO: guide the user through creating their own Google Drive
    # OAuth client ID (Google Cloud console) and pass it to rclone.
    # rclone's built-in shared client ID is used until then.
    log_info "Using rclone's default Google Drive client ID."
}

# === rclone Remote Setup ===

check_rclone_remote() {
    local remote
    remote="$(remote_name)"

    if rclone listremotes | grep -qxF "${remote}:"; then
        log_success "rclone remote '$remote' exists"
        return 0
    else
        log_warn "rclone remote '$remote' not found"
        return 1
    fi
}

setup_rclone_remote() {
    local remote
    remote="$(remote_name)"

    echo ""
    log_info "You need to configure an rclone remote for Google Drive."
    echo ""
    echo "This will open an interactive configuration wizard."
    echo "Name the remote '$remote' and choose 'Google Drive' as the storage type."
    echo ""

    read -rp "Run 'rclone config' now? [Y/n]: " run_config
    if [[ "${run_config,,}" != "n" ]]; then
        rclone config

        if ! check_rclone_remote; then
            log_error "Remote '$remote' still not configured. Please run 'rclone config' manually."
            exit 1
        fi
    else
        log_warn "Please configure rclone, then run gdrive-sync-setup again."
        echo "Run: rclone config"
        exit 1
    fi
}

# === Initial Resync ===

run_initial_resync() {
    echo ""
    log_info "Running initial resync to establish bisync baseline..."
    log_info "This may take a while depending on your Google Drive contents."
    echo ""

    if "$SELF_DIR/gdrive-sync" --resync; then
        log_success "Initial resync completed!"
    else
        log_error "Initial resync failed. Check logs at $STATE_DIR/logs/"
        echo "You can retry with: gdrive-sync --resync"
    fi
}

# === Enable Services ===

enable_services() {
    echo ""
    systemctl --user daemon-reload

    local unit all_enabled=1
    for unit in "${UNITS[@]}"; do
        if ! systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
            all_enabled=0
        fi
    done

    if [[ $all_enabled -eq 1 ]]; then
        log_info "Services are already enabled for your user."
        read -rp "Restart them to apply the new configuration? [Y/n]: " restart_now
        if [[ "${restart_now,,}" != "n" ]]; then
            systemctl --user restart "${UNITS[@]}"
            log_success "Services restarted"
        fi
        return
    fi

    read -rp "Enable and start the sync services for your user now? [Y/n]: " enable_now
    if [[ "${enable_now,,}" == "n" ]]; then
        log_info "Services left disabled. Enable them later with:"
        echo "  systemctl --user enable --now ${UNITS[*]}"
        return
    fi

    systemctl --user enable --now "${UNITS[@]}"
    log_success "Services enabled and started"
}

# === Main ===

main() {
    echo ""
    echo "=========================================="
    echo "  Setup gdrive-sync"
    echo "=========================================="
    echo ""

    check_not_root
    check_dependencies
    configure
    setup_client_id

    if ! check_rclone_remote; then
        setup_rclone_remote
    fi

    echo ""
    read -rp "Run initial resync now? (Recommended for first setup) [Y/n]: " do_resync
    if [[ "${do_resync,,}" != "n" ]]; then
        run_initial_resync
    fi

    enable_services

    echo ""
    echo "=========================================="
    log_success "Setup complete!"
    echo "=========================================="
    echo ""
    echo "Your Google Drive syncs with: $LOCAL_DIR"
    echo ""
    echo "Useful commands:"
    echo "  gdrive-sync                 - Manual sync"
    echo "  gdrive-sync --resync        - Full resync (recovery)"
    echo "  systemctl --user status gdrive-sync-watch.service"
    echo "  cat $STATE_DIR/status.json  - Check sync status"
    echo ""
    echo "Logs:   $STATE_DIR/logs/"
    echo "Config: $CONFIG_FILE"
    echo ""
}

main "$@"
